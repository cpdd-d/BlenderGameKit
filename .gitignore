# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Build artifacts (regenerated by scripts/build_and_test.ps1)
_dist/
# 散落在仓库各处的打包 zip(如根目录的 bgk.zip)——产物,不该进版本库
*.zip
# 临时测试仓库:build_and_test.ps1 每次跑完都会删掉它,
# 跟踪它只会让 `git status` 每次冒出一片删除。它本来就是产物。
_testrepo/

# Godot: 导入缓存/编辑器状态,由 Godot 自动生成,不该进版本库
.godot/

# Blender artifacts
*.blend1
*.blend2
*.blend@

# Local scratch
.audit/
*.log

# ── 导出产物:examples/ 下面那些 *_godot/ 是**跑一次就生成**的东西 ──────
# 里面的 .glb / .import / .uid / trés 全是导出器写的,提交它们会:
#   1) 版本库迅速变大(.glb 是二进制)
#   2) 每次导出都产生一堆"改动",把真正的代码改动淹掉
# 真正该进版本库的是**源文件**:.blend、节点图脚本生成器、README。
examples/**/*_godot/
examples/**/art/*.glb
examples/**/*.import
examples/**/*.uid
examples/**/.gk_generated

# Blender 资产目录文件(打开带资产的 .blend 时自动生成,不是源文件)
blender_assets.cats.txt
