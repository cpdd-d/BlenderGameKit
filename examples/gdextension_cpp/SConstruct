#!/usr/bin/env python
"""SCons 构建脚本(GDExtension 官方推荐方式)。

用法:
    # 先准备 godot-cpp(和你的 Godot 版本对应)
    git clone -b 4.4 https://github.com/godotengine/godot-cpp

    # 然后在本目录:
    scons platform=windows target=template_debug -j8
    scons platform=windows target=template_release -j8

产物会自动放到 res://bin/ 下，对应 gk_demo.gdextension 里写的路径。
"""

import os

# godot-cpp 的位置:默认在本目录同级
GODOT_CPP_PATH = os.environ.get("GODOT_CPP_PATH", "../godot-cpp")

env = SConscript(os.path.join(GODOT_CPP_PATH, "SConstruct"))  # noqa: F821

# 我们自己要编译的源文件
sources = Glob("src/*.cpp")

# 输出到 res://bin/
env.Append(LIBPATH=[env["bindir"]])

library = env.SharedLibrary(
    target=os.path.join("bin", "gk_demo{}{}".format(env["suffix"], env["SHLIBSUFFIX"])),
    source=sources,
)

Default(library)
